@startuml hh-auto-extension
!theme plain
skinparam backgroundColor #FFFFFF
!option handwritten false
skinparam maxMessageSize 150

title Алгоритм работы расширения HH Auto Extension

start

:Д1. Инициализация CONFIG; <<#LightBlue>>
note right
  minDelay: 2000ms
  maxDelay: 4000ms
  maxVacancies: 10
  doneDelay: 12000ms
  excludeKeywords: ['разработчик', 'реклам']
  coverLetter: текст письма
end note

:Ы1. '=== Начало работы ==='; <<objectSignal>> <<#pink>>

:Д2. Проверка авторизации; <<#LightBlue>>

if (У1. Авторизован?) then (нет)
  :Ы2. 'Не залогинен. Останов'; <<objectSignal>> <<#pink>>
  stop
else (да)
  :Ы3. 'Авторизация подтверждена'; <<objectSignal>> <<#pink>>
endif

:Д3. Переход на vidnoe.hh.ru; <<#LightBlue>>
:Ы4. 'перешел на начальную страницу'; <<objectSignal>> <<#pink>>

:Д4. Переход к списку резюме; <<#LightBlue>>
:Ы5. 'перешел на список резюме'; <<objectSignal>> <<#pink>>

:Д5. Получение списка резюме (АВВР1); <<#LightBlue>>

if (У2. Резюме найдены?) then (нет)
  :Ы6. 'не нашел ни одного резюме'; <<objectSignal>> <<#pink>>
  :Ы7. 'останов'; <<objectSignal>> <<#pink>>
  stop
else (да)
  :Ы8. 'Список резюме: ...'; <<objectSignal>> <<#pink>>
endif

:Д6. Инициализация счетчика резюме r=0; <<#LightBlue>>

while (Ц1. r < resumeList.length?) is (да)
  :Д7. Взять резюме r; <<#LightBlue>>
  :Д8. r++; <<#LightBlue>>
  
  :Ы9. '=== Обработка резюме r/M ==='; <<objectSignal>> <<#pink>>
  
  :Д9. Открытие резюме; <<#LightBlue>>
  
  if (У3. Ссылка на резюме найдена?) then (нет)
    :Ы10. 'Не нашел ссылку на резюме'; <<objectSignal>> <<#pink>>
  else (да)
    :Д10. Открыть резюме; <<#LightBlue>>
    :Ы11. 'перешел на мое резюме = ... ='; <<objectSignal>> <<#pink>>
    
    :Д11. Поиск ссылки на вакансии; <<#LightBlue>>
    
    if (У4. Ссылка на вакансии найдена?) then (нет)
      :Ы12. 'Ссылка на вакансии не найдена'; <<objectSignal>> <<#pink>>
      :Д12. Закрыть вкладку резюме; <<#LightBlue>>
    else (да)
      :Д13. Открыть вакансии; <<#LightBlue>>
      :Ы13. 'перешел на вакансии для резюме = ... ='; <<objectSignal>> <<#pink>>
      
      :Д14. Получение списка вакансий (maxVacancies); <<#LightBlue>>
      :Ы14. 'Найдено X уникальных вакансий'; <<objectSignal>> <<#pink>>
      
      :Д15. Инициализация счетчика i=0; <<#LightBlue>>
      
      while (Ц2. i < vacanciesToProcess.length?) is (да)
        :Д16. Взять вакансию i; <<#LightBlue>>
        :Д17. i++; <<#LightBlue>>
        
        if (У5. Название в excludeKeywords?) then (да)
          :Ы15. 'название вакансии =пропущено='; <<objectSignal>> <<#pink>>
        else (нет)
          :Д18. Определить резюме по ПВР1; <<#LightBlue>>
          :Ы16. 'Выбрано резюме: X'; <<objectSignal>> <<#pink>>
          
          :Д19. Создать вкладку; <<#LightBlue>>
          :Ы17. 'Создана вкладка id=X'; <<objectSignal>> <<#pink>>
          
          if (У6. Кнопка "Откликнуться" найдена?) then (нет)
            :Ы18. 'КНОПКА_ОТКЛИКНУТЬСЯ_НЕ_НАЙДЕНА'; <<objectSignal>> <<#pink>>
          else (да)
            :Ы19. 'кнопку =откликнуться= нашел, сейчас буду нажимать'; <<objectSignal>> <<#pink>>
            :Д20. Нажать кнопку; <<#LightBlue>>
            :Ы20. 'после нажатия на =откликнуться= все загружено успешно'; <<objectSignal>> <<#pink>>
            
            :Ы21. '=Это новая вакансия=. Начинаю выполнять МОР1'; <<objectSignal>> <<#pink>>
            
            if (У7. Найден ровно 1 dialog?) then (нет)
              :Ы22. 'модальное не найдено. Останов'; <<objectSignal>> <<#pink>>
            else (да)
              :Ы23. 'открылось модальное'; <<objectSignal>> <<#pink>>
              
              if (У8. Найден ровно 1 resume-title?) then (нет)
                :Ы24. 'в модальном окне больше одного элемента выбора вакансии. останов.'; <<objectSignal>> <<#pink>>
              else (да)
                if (У9. Найдена кнопка "Откликнуться" в модальном окне?) then (нет)
                  :Ы25. 'условие на нахождение элемента =откликнуться= в диалоговом окне не выполнено'; <<objectSignal>> <<#pink>>
                else (да)
                  if (У10. Кнопка "Добавить сопроводительное" найдена И\nкнопка "Откликнуться" кликабельна?) then (да)
                    :Ы26. 'Тип модального окна: simple1'; <<objectSignal>> <<#pink>>
                    
                    :Д21. Выбор резюме (ПВР1); <<#LightYellow>>
                    :Ы27. 'Резюме выбрано'; <<objectSignal>> <<#pink>>
                    
                    :Д22. Проверка полей ввода; <<#LightGreen>>
                    
                    if (У11. Есть непонятные поля ввода?) then (да)
                      :Ы28. 'есть непонятные поля ввода'; <<objectSignal>> <<#pink>>
                    else (нет)
                      :Ы29. 'Нажимаю кнопку "Добавить сопроводительное"'; <<objectSignal>> <<#pink>>
                      :Д23. Нажать "Добавить сопроводительное"; <<#LightGreen>>
                      
                      if (У12. Textarea найден?) then (да)
                        :Ы30. 'Нашёл поле для сопроводительного письма'; <<objectSignal>> <<#pink>>
                        :Д24. Вставка текста; <<#LightGreen>>
                        :Ы31. 'Вставил сопроводительное письмо'; <<objectSignal>> <<#pink>>
                        
                        if (У13. Кнопка "Откликнуться" кликабельна?) then (да)
                          :Ы32. 'Отправляю отклик'; <<objectSignal>> <<#pink>>
                          :Д25. Нажать кнопку "Откликнуться"; <<#LightGreen>>
                        else (нет)
                          :Ы33. 'Кнопка отправки не найдена или заблокирована'; <<objectSignal>> <<#pink>>
                        endif
                      else (нет)
                        :Ы34. 'Поле для сопроводительного письма не найдено'; <<objectSignal>> <<#pink>>
                      endif
                    endif
                  elseif (У14. Textarea уже открыт И\nкнопка "Добавить сопроводительное" отсутствует И\nкнопка "Откликнуться" disabled И\nтекст "Сопроводительное письмо"?) then (да)
                    :Ы35. 'Тип модального окна: simple2'; <<objectSignal>> <<#pink>>
                    
                    :Д26. Выбор резюме (ПВР1); <<#LightYellow>>
                    :Ы36. 'Резюме выбрано'; <<objectSignal>> <<#pink>>
                    
                    :Ы37. 'Поле для сопроводительного письма уже открыто'; <<objectSignal>> <<#pink>>
                    :Д27. Вставка текста; <<#LightGreen>>
                    :Ы38. 'Вставил сопроводительное письмо'; <<objectSignal>> <<#pink>>
                    
                    if (У15. Кнопка "Откликнуться" кликабельна?) then (да)
                      :Ы39. 'Отправляю отклик'; <<objectSignal>> <<#pink>>
                      :Д28. Нажать кнопку "Откликнуться"; <<#LightGreen>>
                    else (нет)
                      :Ы40. 'Кнопка отправки не найдена или заблокирована'; <<objectSignal>> <<#pink>>
                    endif
                  else (нет)
                    :Ы41. '=тип модального окна не определен=, останов'; <<objectSignal>> <<#pink>>
                  endif
                endif
              endif
            endif
          endif
          
          :Д29. Отправить сообщение в background; <<#LightGreen>>
          note right
            chrome.runtime.sendMessage(
              { action: 'responseSent' }
            )
          end note
        endif
      endwhile (нет)
      
      :Ы42. 'Получено сообщение: отклик отправлен'; <<objectSignal>> <<#pink>>
      :Ы43. 'Жду 12000мс перед закрытием вкладки'; <<objectSignal>> <<#pink>>
      
      :Д30. Подождать doneDelay; <<#LightBlue>>
      :Д31. Закрыть вкладку вакансии; <<#LightBlue>>
      :Ы44. 'Закрыл вкладку вакансии'; <<objectSignal>> <<#pink>>
      
      :Д32. Закрыть вкладки резюме и вакансий; <<#LightBlue>>
      :Ы45. 'Закрыл вкладки для резюме = ... ='; <<objectSignal>> <<#pink>>
    endif
  endif
endwhile (нет)

:Ы46. '=== Работа завершена ==='; <<objectSignal>> <<#pink>>

stop

legend right
  **Легенда:**
  |Цвет |Зона ответственности |
  |<#LightBlue> |Background Script |
  |<#LightGreen> |МОР1 (модальное окно) |
  |<#LightYellow> |ПВР1 (выбор резюме) |
  |<#pink> |Вывод в консоль <<objectSignal>> |
  
  **Идентификаторы:**
  * **Д** - Действия
  * **Ы** - Вывод на консоль
  * **У** - Условия
  * **Ц** - Циклы
  
  **Типы модальных окон:**
  * **simple1**: есть кнопка "Добавить сопроводительное", кнопка "Откликнуться" кликабельна
  * **simple2**: textarea уже открыт, кнопка "Добавить сопроводительное" отсутствует, кнопка "Откликнуться" disabled, текст "Сопроводительное письмо"
  
  **ПВР1 - Приоритеты выбора резюме:**
  1. "отдела" → "Руководитель отдела"
  2. "руководитель направления"/"деливери"/"delivery"/"релиз" → "Руководитель направления"
  3. "аналитик"/"системн"/"анализа" → "Аналитик"
  4. "проект"/"менеджер"/"project manager" → "Руководитель проектов"
  5. остальное → "Руководитель направления"
  
  **Параметры CONFIG:**
  * minDelay, maxDelay: задержки (мс)
  * maxVacancies: макс. вакансий
  * doneDelay: задержка после отправки отклика (12000мс = 12 сек)
  * excludeKeywords: ключевые слова для исключения
  * coverLetter: текст письма
  
  **Механизм сообщений:**
  * Content script отправляет сообщение после нажатия кнопки "Откликнуться"
  * Background script ждёт doneDelay и закрывает вкладку
endlegend

@enduml
